# --- konfiguracja lokalna (kontraktem jest .env.example) ---
# Wzorzec obejmuje warianty (.env.dev.claude, .env.openai), bo trzymamy obok siebie kilka
# konfiguracji dostawców — każda z żywym kluczem. Wyjątek jest jeden i jawny: .env.example.
.env
.env.*
!.env.example

# --- artefakty i dane wejściowe: zawierają dane klientów (PII) ---
# Ignorowane jest wszystko w data/ poza data/safe/ — także katalog założony tam przez pomyłkę.
# W data/safe/ leżą wyłącznie dane zmyślone; dane klientów trzymamy w data/unsafe/.
data/*
!data/safe/

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- narzędzia i edytory ---
.idea/
.vscode/

# --- frontend (dojdzie w etapie 8) ---
node_modules/
