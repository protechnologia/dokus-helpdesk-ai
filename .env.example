# Configuration contract for the whole compose project — every variable used by any service
# must appear here. Copy to .env and adjust locally; .env is NOT versioned.

# --- observability ---
LOG_LEVEL=INFO

# --- LLM ---
# `fake` keeps the stack offline and free: no request leaves the machine.
# It is also the ONLY provider implemented so far — a real, OpenAI-compatible client (incl.
# Bielik on RunPod) arrives in stage 5; any other value fails fast with LLMConfigError.
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60

# --- embedder service ---
EMBEDDING_BASE_URL=http://embedder:8000
# Read by the `embedder` service, not by `api`: which backend turns text into vectors.
# `fake` needs no weights and no GPU — a real, sentence-transformers backend (PolDense) arrives
# in stage 2; any other value fails fast with EncoderConfigError at startup.
EMBEDDING_BACKEND=fake
EMBEDDING_VECTOR_SIZE=768
EMBEDDING_TIMEOUT_SECONDS=30

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tickets
QDRANT_TIMEOUT_SECONDS=30
