# Configuration contract for the whole compose project — every variable used by any service
# must appear here. Copy to .env and adjust locally; .env is NOT versioned.

# --- DOCKER_* : resolved by `docker compose` itself, never handed to a container ---
# The prefix IS the contract: a DOCKER_* variable is interpolated into the compose file and stops
# there, so no Settings class declares it and none ever should. Everything below this block is the
# opposite — it reaches a container and some service reads it.
#
# All five steer the HOST side of a port mapping (`address:host_port:container_port`). The
# container side is FIXED (8000 for both apps, 6333 for Qdrant, 5432 for Postgres) and no variable
# touches it: services reach each other by service name and container port (EMBEDDING_BASE_URL,
# QDRANT_URL, POSTGRES_HOST below), so changing anything here is invisible inside the compose
# network. A port already taken
# on the machine is therefore a one-line fix in .env, never an edit to the compose file.

# Loopback by default: the stack has no authentication yet (see CLAUDE.md -> TODO), so it must
# not answer from the network without a deliberate decision.
DOCKER_BIND_ADDR=127.0.0.1
# api defaults to 8010 rather than 8000: 8000 is commonly occupied by another local project.
DOCKER_API_PORT=8010
DOCKER_EMBEDDER_PORT=8001
DOCKER_QDRANT_PORT=6333
# 5433, nie 5432: lokalny Postgres na domyślnym porcie jest częsty.
DOCKER_POSTGRES_PORT=5433

# --- observability ---
LOG_LEVEL=INFO

# --- LLM: dwie osobne konfiguracje, po jednej na rolę ---
# Każda rola ma własny komplet tych samych ośmiu zmiennych i nic nie dziedziczy po drugiej.
# Znaczenie zmiennych jest w obu takie samo:
#   PROVIDER          `fake` (domyślny: nic nie wychodzi z maszyny i nic nie kosztuje), `claude`,
#                     `openai` albo `ollama` (endpoint zgodny z OpenAI: Ollama, vLLM, RunPod).
#                     Inna wartość to błąd przy budowie klienta.
#   BASE_URL          puste = oficjalne API dostawcy; przy `ollama` puste = localhost:11434.
#   API_KEY, MODEL    wymagane przy `claude` i `openai` (fabryka odmawia bez nich, nazywając
#                     brakującą zmienną); przy `ollama` wystarcza MODEL. Model dostawcy chmurowego
#                     musi mieć stawki w api/app/engine_llm/pricing/ — inaczej klient nie
#                     powstanie, bo przebieg nie dałby się wycenić.
#   NUM_CTX,          okno kontekstu i budżet odpowiedzi — tylko dla modeli self-hosted (`ollama`);
#   MAX_OUTPUT_TOKENS dostawcy chmurowi oba ignorują. Wartość musi mieścić się w oknie modelu:
#                     Ollama domyślnie tnie do 2048 tokenów i ucina nadmiar BEZ BŁĘDU, więc klient
#                     podaje ją jawnie i odmawia zbyt długiego wejścia. Budżet odpowiedzi jest
#                     odejmowany od okna, nie doliczany.

# Rola generująca: model, który pisze odpowiedzi w grafach (bramki, propozycje, wyszukiwanie).
# Dostaje tekst po anonimizacji; prawdziwy model bez prawdziwego anonimizatora to odmowa startu.
LLM_GENERATION_PROVIDER=fake
LLM_GENERATION_BASE_URL=
LLM_GENERATION_API_KEY=
LLM_GENERATION_MODEL=
LLM_GENERATION_TEMPERATURE=0
LLM_GENERATION_TIMEOUT_SECONDS=60
LLM_GENERATION_NUM_CTX=8192
LLM_GENERATION_MAX_OUTPUT_TOKENS=1500

# Rola anonimizująca: model, który pomaga anonimizatorowi rozpoznawać dane osobowe.
# UWAGA: ten model widzi SUROWY tekst zgłoszeń. To, co tu wpiszesz, jest decyzją o tym, dokąd
# ten tekst trafia — ma to być model pod naszą kontrolą (self-hosted), nie dostawca komercyjny.
LLM_ANONYMIZATION_PROVIDER=fake
LLM_ANONYMIZATION_BASE_URL=
LLM_ANONYMIZATION_API_KEY=
LLM_ANONYMIZATION_MODEL=
LLM_ANONYMIZATION_TEMPERATURE=0
LLM_ANONYMIZATION_TIMEOUT_SECONDS=60
LLM_ANONYMIZATION_NUM_CTX=8192
LLM_ANONYMIZATION_MAX_OUTPUT_TOKENS=1500

# --- embedder service ---
EMBEDDING_BASE_URL=http://embedder:8000
# Read by the `embedder` service, not by `api`: which backend turns text into vectors.
# `sentence-transformers` loads the model named below — the default, because a stack that cannot
# compute a real vector is useless for stages 3-4. Set `fake` for a weightless start: no download,
# no GPU, deterministic nonsense vectors. Any other value fails fast at startup.
EMBEDDING_BACKEND=sentence-transformers
# Which model the real backend loads — required by `sentence-transformers`, ignored by `fake`.
# A PARAMETER of one backend, not a backend of its own: PolDense, mmlw and BGE-M3 load the same
# way, so stage 3 compares them by changing this line alone. The working choice is PolDense-150M
# (768 dimensions, ~600 MB fetched once into the hf_cache volume).
EMBEDDING_MODEL=OPI-PIB/PolDense-150M
EMBEDDING_VECTOR_SIZE=768
# Musi pomieścić NAJWOLNIEJSZE wywołanie, czyli batch indeksacji na zimnym modelu — nie zapytanie
# runtime. Zmierzone 2026-08-13 na CPU (PolDense-150M, batch 32 realnych artefaktów): ~9 s przy
# ciepłym modelu, ale pierwsze wywołanie po starcie kontenera przekraczało 30 s i wywalało cały
# przebieg `helpdesk index build`. 120 s daje zapas także na wolniejszą maszynę.
EMBEDDING_TIMEOUT_SECONDS=120

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tickets
# Kolekcja dokumentacji (fragmenty sekcji instrukcji). Paczka zmyślona trafia do osobnej kolekcji
# o tej nazwie z dopiskiem `_synthetic` (`helpdesk docs index --synthetic`).
QDRANT_DOCS_COLLECTION=docs
QDRANT_TIMEOUT_SECONDS=30

# --- Postgres (indeks wyszukiwania tekstowego z polskim słownikiem) ---
# Host i port po stronie sieci compose — `api` łączy się z usługą po nazwie. Port na hoście to
# DOCKER_POSTGRES_PORT wyżej i tych dwóch zmiennych nie dotyczy.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Te trzy czyta i `api`, i sama usługa `postgres`. Obraz Postgresa stosuje je TYLKO przy
# pierwszym starcie na pustym wolumenie: zmiana tutaj nie zmienia hasła w istniejącej bazie.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
# Wartość dev-owa. Wdrożenie podaje własną — stack domyślnie słucha tylko na 127.0.0.1.
POSTGRES_PASSWORD=helpdesk
# Limit na łączenie i na każde zapytanie, w sekundach.
POSTGRES_TIMEOUT_SECONDS=30

# --- retrieval (strojenie wyszukiwania) ---
# Ile rekordów wraca z Qdranta na jedno zapytanie. Do promptu generacji idzie z tego 1-3 rekordy;
# ta liczba jest pulą, którą próg i zwijanie zawężają. Więcej rozmywa odpowiedź.
# Ta sama liczba ogranicza wynik obu wyszukiwań w dokumentacji (liczba sekcji).
RAG_TOP_K=5
# Minimalny score trafienia (cosinus, zakres -1.0 .. 1.0). Zmierzone 2026-08-20 na 171 rekordach:
# 0.48 zachowuje 157 ze 162 trafień poprawnych (96,9%) i wycisza całkiem 14 z 16 dystraktorów,
# odcinając 97,5% ich trafień. Raport: data/unsafe/docs/pomiar-progu-score.md.
# Wybór świadomie po stronie odsiewania śmieci: przy 47% singletonów „nic nie znalazłem" jest
# normalną odpowiedzią, a trafienie bez treści wygląda na odpowiedź i jest gorsze niż jej brak.
# CENA, którą trzeba znać: wypadają cztery trafienia poprawne, z czego TRZY stoją na pierwszym
# miejscu (np. „Brakuje wizualizacji UPP" wobec „Brak wizualizacji UPP w dokumencie" — 0.455).
# Krótkie teksty po obu stronach dają niski cosinus mimo idealnego dopasowania, więc ten próg
# systematycznie karze najkrótsze rekordy. Wyżej NIE PODNOSIĆ bez powtórzenia pomiaru: 0.50
# zabiera kolejne cztery, w tym „Nie da się zakładać nowych spraw" (0.499).
# Próg jest DOLNYM oszacowaniem — zmierzony na 171 rekordach wobec docelowych ~1100 (etap 10),
# a score dystraktorów rośnie z rozmiarem korpusu. Powtórzyć: `python scripts/eval_threshold.py`.
RAG_SCORE_MIN=0.48
# Najwyżej tyle znaków ma fragment sekcji dokumentacji, z którego embedder liczy jeden wektor.
# Sekcja krótsza to jeden fragment, dłuższa jest cięta po akapitach. Zmierzone 2026-10-05 na
# paczce syntetycznej: 1000 trafia w szczegół z końca długiej sekcji pewniej niż 1500; wartość
# wraca do pomiaru na właściwej dokumentacji. Po zmianie trzeba powtórzyć `helpdesk docs index`.
# Najmniej 1.
RAG_DOCS_FRAGMENT_CHARS=1000
# Minimalne podobieństwo sekcji dokumentacji do zapytania (cosinus), osobne od RAG_SCORE_MIN.
# Zmierzone 2026-10-05 na paczce syntetycznej: 0.37 zachowuje wszystkie 24 zapytania z odpowiedzią
# i wycisza 4 z 5 zapytań bez odpowiedzi; 0.39 wycisza wszystkie 5, ale gubi jedno z 24.
# Wartość wstępna, do przeliczenia na właściwej dokumentacji.
RAG_DOCS_SCORE_MIN=0.37

# --- agent (limity wywołań narzędzi) ---
# Ile razy model może wywołać dane narzędzie przy jednej sprawie. Wywołanie ponad limit dostaje
# błąd zamiast wyniku, a model ma odpowiedzieć na podstawie tego, co już ma — pętla nie zużywa
# wtedy tokenów bez końca. Ta sama liczba stoi w opisie narzędzia, który czyta model.
# Wyszukiwanie jest tanie (numery albo opisy sekcji), więc każde ma 5; jedno wywołanie tekstowe
# to jedna fraza, a zgłoszenie niesie ich bywa kilka. Karty są krótkie (do 20 na wywołanie),
# więc też 5. Drogi jest odczyt sekcji (do 5 na wywołanie) i wątków (jeden na wywołanie): po 3,
# czyli najwyżej 3 wątki na sprawę. Najmniej 1.
AGENT_MAX_CALLS_FIND_TICKETS_VECTOR=5
AGENT_MAX_CALLS_FIND_TICKETS_TEXT=5
AGENT_MAX_CALLS_READ_TICKETS_CARD=5
AGENT_MAX_CALLS_READ_TICKETS_THREAD=3
AGENT_MAX_CALLS_LIST_DOCS=1
AGENT_MAX_CALLS_FIND_DOCS_VECTOR=5
AGENT_MAX_CALLS_FIND_DOCS_TEXT=5
AGENT_MAX_CALLS_READ_DOCS=3

# --- agent (limit tur modelu) ---
# Ile razy model może odpowiedzieć przy jednej sprawie w grafie z narzędziami (wyszukiwanie,
# propozycje). Gdy w ostatniej dozwolonej turze nadal woła narzędzia, nie są już wykonywane
# i przebieg idzie do odpowiedzi. To zapas na model, który kręci się w kółko, nie cel: sprawa to
# zwykle 4–7 tur, a limity narzędzi wyżej pozwalają razem na 32 wywołania, po kilka na turę.
# Najmniej 1.
AGENT_MAX_ITERATIONS=20
