# Configuration contract for the whole compose project — every variable used by any service
# must appear here. Copy to .env and adjust locally; .env is NOT versioned.

# --- DOCKER_* : resolved by `docker compose` itself, never handed to a container ---
# The prefix IS the contract: a DOCKER_* variable is interpolated into the compose file and stops
# there, so no Settings class declares it and none ever should. Everything below this block is the
# opposite — it reaches a container and some service reads it.
#
# All four steer the HOST side of a port mapping (`address:host_port:container_port`). The
# container side is FIXED (8000 for both apps, 6333 for Qdrant) and no variable touches it:
# services reach each other by service name and container port (EMBEDDING_BASE_URL, QDRANT_URL
# below), so changing anything here is invisible inside the compose network. A port already taken
# on the machine is therefore a one-line fix in .env, never an edit to the compose file.

# Loopback by default: the stack has no authentication yet (see CLAUDE.md -> TODO), so it must
# not answer from the network without a deliberate decision.
DOCKER_BIND_ADDR=127.0.0.1
# api defaults to 8010 rather than 8000: 8000 is commonly occupied by another local project.
DOCKER_API_PORT=8010
DOCKER_EMBEDDER_PORT=8001
DOCKER_QDRANT_PORT=6333

# --- observability ---
LOG_LEVEL=INFO

# --- LLM ---
# `fake` keeps the stack offline and free: no request leaves the machine, so it stays the default.
# `claude` and `openai` talk to their vendor APIs and REQUIRE both LLM_API_KEY and LLM_MODEL — the
# factory refuses to build without them, naming whichever is missing. Any other value fails fast
# with LLMConfigError.
LLM_PROVIDER=fake
# Puste = oficjalne API dostawcy. Ustawione działa tylko przy `openai` i wskazuje endpoint zgodny
# z jego API — tą drogą wchodzi Bielik na RunPodzie, Ollama i vLLM.
LLM_BASE_URL=
LLM_API_KEY=
# Puste przy `fake`. Przy dostawcy chmurowym model musi mieć stawki w app/llm/pricing_<dostawca>.py
# — inaczej klient nie powstanie, bo przebieg nie dałby się wycenić.
# Wycenione dziś: claude-haiku-4-5, claude-sonnet-5, claude-opus-5 · gpt-5.4, gpt-5.4-mini, gpt-4.1,
# gpt-4.1-mini, o4-mini.
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
# Okno kontekstu i budżet odpowiedzi — tylko dla modeli self-hosted (`ollama`); dostawcy chmurowi
# oba ignorują. Wartość musi mieścić się w oknie modelu: Ollama domyślnie tnie do 2048 tokenów
# i ucina nadmiar BEZ BŁĘDU, więc klient podaje ją jawnie i odmawia zbyt długiego zgłoszenia.
# Budżet odpowiedzi jest odejmowany od okna, nie doliczany.
LLM_NUM_CTX=8192
LLM_MAX_OUTPUT_TOKENS=1500

# --- embedder service ---
EMBEDDING_BASE_URL=http://embedder:8000
# Read by the `embedder` service, not by `api`: which backend turns text into vectors.
# `sentence-transformers` loads the model named below — the default, because a stack that cannot
# compute a real vector is useless for stages 3-4. Set `fake` for a weightless start: no download,
# no GPU, deterministic nonsense vectors. Any other value fails fast at startup.
EMBEDDING_BACKEND=sentence-transformers
# Which model the real backend loads — required by `sentence-transformers`, ignored by `fake`.
# A PARAMETER of one backend, not a backend of its own: PolDense, mmlw and BGE-M3 load the same
# way, so stage 3 compares them by changing this line alone. The working choice is PolDense-150M
# (768 dimensions, ~600 MB fetched once into the hf_cache volume).
EMBEDDING_MODEL=OPI-PIB/PolDense-150M
EMBEDDING_VECTOR_SIZE=768
# Musi pomieścić NAJWOLNIEJSZE wywołanie, czyli batch indeksacji na zimnym modelu — nie zapytanie
# runtime. Zmierzone 2026-08-13 na CPU (PolDense-150M, batch 32 realnych artefaktów): ~9 s przy
# ciepłym modelu, ale pierwsze wywołanie po starcie kontenera przekraczało 30 s i wywalało cały
# przebieg `helpdesk index build`. 120 s daje zapas także na wolniejszą maszynę.
EMBEDDING_TIMEOUT_SECONDS=120

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tickets
QDRANT_TIMEOUT_SECONDS=30

# --- retrieval (strojenie wyszukiwania) ---
# Ile rekordów wraca z Qdranta na jedno zapytanie. Do promptu generacji idzie z tego 1-3 rekordy;
# ta liczba jest pulą, którą próg i zwijanie zawężają. Więcej rozmywa odpowiedź.
RAG_TOP_K=5
# Minimalny score trafienia (cosinus, zakres -1.0 .. 1.0). Domyślnie 0.0, czyli NIC nie jest
# odcinane, dopóki nie zostanie zmierzone. Próg zgadnięty z góry po cichu ukryłby przypadek,
# którego ten korpus jest pełen: prawie identyczne `problem` o rozłącznych przyczynach, które
# MUSZĄ trafić do promptu razem, bo inaczej wariant `questions` nie ma czego rozróżniać.
RAG_SCORE_MIN=0.0
